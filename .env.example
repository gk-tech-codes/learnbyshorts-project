# Public browser configuration. Never put secrets in this file.
LEARNBYSHORTS_API_BASE_URL=https://api.example.com
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com

# Lambda-only configuration. Store these in AWS Lambda environment variables
# backed by Secrets Manager or SSM Parameter Store, never in Git.
JWT_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=https://learnbyshorts.com,https://www.learnbyshorts.com
TABLE_NAME=learnbyshorts-data
AWS_REGION=us-east-1
